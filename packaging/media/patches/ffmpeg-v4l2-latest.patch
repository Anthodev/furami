+/* Caller holds owner->mutex across the syscall and accounting update. */
+static int latest_enqueue_locked(struct latest_owner *owner, struct v4l2_buffer *buf)
+{
+    int res;
+
+    if (owner->retired)
+        return AVERROR(ENODEV);
+    if (buf->index >= owner->buffers || owner->queued[buf->index])
+        return AVERROR(EINVAL);
+    if (owner->ioctl_f(owner->fd, VIDIOC_QBUF, buf) < 0) {
+        res = AVERROR(errno);
+        av_log(NULL, AV_LOG_ERROR, "ioctl(VIDIOC_QBUF): %s\n", av_err2str(res));
+        return res;
+    }
+    owner->queued[buf->index] = 1;
+    owner->buffers_queued++;
+    return 0;
+}

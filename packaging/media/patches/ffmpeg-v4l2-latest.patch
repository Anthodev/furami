+static void latest_owner_unref(struct latest_owner *owner)
+{
+    if (atomic_fetch_sub(&owner->refs, 1) != 1)
+        return;
+    for (int i = 0; i < owner->mapped; i++)
+        owner->munmap_f(owner->buf_start[i], owner->buf_len[i]);
+    av_free(owner->buf_start);
+    av_free(owner->buf_len);
+    av_free(owner->queued);
+    pthread_mutex_destroy(&owner->mutex);
+    av_free(owner);
+}
+
+static int latest_owner_init(struct video_data *s)
+{
+    struct latest_owner *owner = av_mallocz(sizeof(*owner));
+    int res;
+
+    if (!owner)
+        return AVERROR(ENOMEM);
+    res = pthread_mutex_init(&owner->mutex, NULL);
+    if (res) {
+        av_free(owner);
+        return AVERROR(res);
+    }
+    atomic_init(&owner->refs, 1);
+    owner->fd = s->fd;
+    owner->buffers = s->buffers;
+    owner->ioctl_f = s->ioctl_f;
+    owner->close_f = s->close_f;
+    owner->munmap_f = s->munmap_f;
+    owner->buf_start = av_malloc_array(s->buffers, sizeof(*owner->buf_start));
+    owner->buf_len = av_malloc_array(s->buffers, sizeof(*owner->buf_len));
+    owner->queued = av_calloc(s->buffers, sizeof(*owner->queued));
+    if (!owner->buf_start || !owner->buf_len || !owner->queued) {
+        latest_owner_unref(owner);
+        return AVERROR(ENOMEM);
+    }
+    s->latest = owner;
+    s->buf_start = owner->buf_start;
+    s->buf_len = owner->buf_len;
+    return 0;
+}
+
+static int latest_owner_retire(struct latest_owner *owner)
+{
+    int res = 0;
+
+    pthread_mutex_lock(&owner->mutex);
+    if (!owner->retired) {
+        int fd = owner->fd;
+        enum v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+
+        owner->retired = 1;
+        owner->fd = -1;
+        /* Serialize the complete retirement against in-flight callback QBUF.
+         * No callback can use a closed, subsequently reused descriptor. */
+        if (owner->streaming)
+            owner->ioctl_f(fd, VIDIOC_STREAMOFF, &type);
+        if (owner->close_f(fd) < 0) {
+            res = AVERROR(errno);
+            av_log(NULL, AV_LOG_ERROR, "close(V4L2): %s\n", av_err2str(res));
+        }
+    }
+    pthread_mutex_unlock(&owner->mutex);
+    return res;
+}
+
+static int buffers_queued(struct video_data *s)
+{
+    int count;
+
+    if (!s->furami_latest)
+        return atomic_load(&s->buffers_queued);
+    pthread_mutex_lock(&s->latest->mutex);
+    count = s->latest->buffers_queued;
+    pthread_mutex_unlock(&s->latest->mutex);
+    return count;
+}

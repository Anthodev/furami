+static int latest_dequeue_buffer(AVFormatContext *ctx, struct v4l2_buffer *buf)
+{
+    struct video_data *s = ctx->priv_data;
+    struct latest_owner *owner = s->latest;
+    int res = 0;
+
+    pthread_mutex_lock(&owner->mutex);
+    if (owner->retired) {
+        res = AVERROR(ENODEV);
+    } else if (owner->ioctl_f(owner->fd, VIDIOC_DQBUF, buf) < 0) {
+        res = AVERROR(errno);
+    } else if (buf->index >= owner->buffers || !owner->queued[buf->index]) {
+        av_log(ctx, AV_LOG_ERROR, "Invalid or already owned V4L2 buffer index.\n");
+        res = AVERROR(EINVAL);
+    } else {
+        owner->queued[buf->index] = 0;
+        owner->buffers_queued--;
+    }
+    pthread_mutex_unlock(&owner->mutex);
+    return res;
+}
+
+/* The descriptor is nonblocking. Only the first candidate may wait; the
+ * bounded drain below never waits for a future completion. */
+static int latest_dequeue_first(AVFormatContext *ctx, struct v4l2_buffer *buf)
+{
+    struct video_data *s = ctx->priv_data;
+    struct pollfd pfd = { .fd = s->fd, .events = POLLIN };
+    int res;
+
+    for (;;) {
+        if (ctx->interrupt_callback.callback &&
+            ctx->interrupt_callback.callback(ctx->interrupt_callback.opaque))
+            return AVERROR_EXIT;
+        res = latest_dequeue_buffer(ctx, buf);
+        if (res == 0)
+            return 0;
+        if (res == AVERROR(EINTR))
+            continue;
+        if (res != AVERROR(EAGAIN))
+            return res;
+        if (ctx->flags & AVFMT_FLAG_NONBLOCK)
+            return AVERROR(EAGAIN);
+        pfd.revents = 0;
+        res = poll(&pfd, 1, 100);
+        if (res < 0) {
+            if (errno == EINTR)
+                continue;
+            return AVERROR(errno);
+        }
+        if (res > 0) {
+            if (pfd.revents & POLLNVAL)
+                return AVERROR(EBADF);
+            if (pfd.revents & (POLLERR | POLLHUP))
+                return AVERROR(ENODEV);
+        }
+    }
+}
+
+static int latest_read_buffer(AVFormatContext *ctx, struct v4l2_buffer *buf)
+{
+    struct video_data *s = ctx->priv_data;
+    int res = latest_dequeue_first(ctx, buf);
+
+    if (res < 0)
+        return res;
+
+    /* Actual REQBUFS count, not desired_video_buffers. Even a continuously
+     * producing device cannot keep this read in an unbounded drain loop. */
+    for (int i = 0; i < s->buffers - 1; i++) {
+        struct v4l2_buffer newer = {
+            .type = s->buf_type,
+            .memory = V4L2_MEMORY_MMAP,
+        };
+        if (ctx->interrupt_callback.callback &&
+            ctx->interrupt_callback.callback(ctx->interrupt_callback.opaque)) {
+            res = AVERROR_EXIT;
+            goto fail;
+        }
+        res = latest_dequeue_buffer(ctx, &newer);
+        if (res < 0) {
+            if (res == AVERROR(EAGAIN))
+                break;
+            if (res == AVERROR(EINTR))
+                continue;
+            goto fail;
+        }
+        /* With B=2 accounting may be zero only during this exchange.
+         * No allocation, copy or wait may be introduced before requeueing. */
+        res = enqueue_buffer(s, buf);
+        if (res < 0) {
+            enqueue_buffer(s, &newer);
+            goto fail;
+        }
+        *buf = newer;
+    }
+    if (ctx->interrupt_callback.callback &&
+        ctx->interrupt_callback.callback(ctx->interrupt_callback.opaque)) {
+        res = AVERROR_EXIT;
+        goto fail;
+    }
+    if (buf->bytesused > s->buf_len[buf->index]) {
+        av_log(ctx, AV_LOG_ERROR, "V4L2 payload exceeds mapped buffer size.\n");
+        res = AVERROR_INVALIDDATA;
+        goto fail;
+    }
+    return 0;
+
+fail:
+    /* Preserve the original failure even if best-effort requeue also fails. */
+    enqueue_buffer(s, buf);
+    return res;
+}
